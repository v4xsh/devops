# Copy to terraform.tfvars and adjust. Never commit real credentials;
# authenticate with `aws configure` / AWS_PROFILE instead.
region             = "ap-south-1"
project            = "deskflow"
environment        = "dev"
cluster_name       = "deskflow-eks"
kubernetes_version = "1.34"
vpc_cidr           = "10.20.0.0/16"
az_count           = 2
single_nat_gateway = true

node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND"
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4

tags = {
  Course = "DevOps Session 21"
}
